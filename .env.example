# =================================================================
# CodeRound Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coderound_db
DB_USERNAME=postgres
DB_PASSWORD=postgresql

# Judge0 CE Execution Engine Configuration
# When running with Docker Compose: http://judge0:2358
# When running standalone locally: http://localhost:2358
# If Judge0 is offline, CodeRound gracefully simulates results so development can continue.
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_ENABLED=true
JUDGE0_API_KEY=

# Spring Boot Server Port
PORT=8080